# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/trusttaste"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-change-in-production"

# Anthropic (Claude AI) - for review moderation
ANTHROPIC_API_KEY="sk-ant-..."

# Admin email (receives flagged review reports)
ADMIN_EMAIL="admin@trusttaste.com"

# Email (Nodemailer - for sending notifications)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your@gmail.com"
EMAIL_PASS="your-app-password"

