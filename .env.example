# ---- Story + metadata generation (required) ----
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-opus-5"

# ---- Channel identity: shapes every idea and script ----
CHANNEL_NAME="Popelino Stories"
CHANNEL_TOPIC="Short, surprising true stories from history and science"
CHANNEL_AUDIENCE="Curious adults who watch on their phone during a commute"
CHANNEL_TONE="Warm, precise, a little wry. No clickbait, no hype."
VIDEO_FORMAT="short"          # short (1080x1920) | long (1920x1080)
TARGET_DURATION_SEC="60"

# ---- Voice ----
TTS_PROVIDER="elevenlabs"     # elevenlabs | silent
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# ---- Visuals ----
IMAGE_PROVIDER="fal"          # fal | openai | placeholder
FAL_API_KEY=""
FAL_MODEL="fal-ai/flux/schnell"
OPENAI_API_KEY=""

# ---- Music ----
# Drop royalty-free loops into assets/music/ and reference them by mood name,
# e.g. assets/music/tense.mp3, assets/music/hopeful.mp3.
MUSIC_DIR="assets/music"
MUSIC_GAIN_DB="-22"

# ---- Rendering ----
# Set only if Remotion cannot download its own Chromium (locked-down CI, Docker).
# Must be a headless-shell build, not a full Chrome binary.
CHROME_EXECUTABLE=""

# ---- YouTube upload ----
# Run `npm run auth:youtube` once to mint the refresh token.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
YOUTUBE_PRIVACY_STATUS="private"   # private | unlisted | public
YOUTUBE_CATEGORY_ID="27"           # 27 = Education
